# FILE: /.env.example
# SplashEstate CRM - Environment Configuration
# Copy this file to .env and update with your settings

# Database Configuration
DB_HOST=localhost
DB_NAME=splashestate_crm
DB_USER=root
DB_PASS=

# Application Configuration
APP_NAME="SplashEstate CRM"
APP_ENV=development
APP_DEBUG=true
BASE_URL=http://localhost/SplashEstateCRM/public

# Session Configuration
SESSION_LIFETIME=7200

# Upload Configuration
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@splashestate.com
MAIL_FROM_NAME="SplashEstate CRM"

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Maps Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Timezone
APP_TIMEZONE=UTC
