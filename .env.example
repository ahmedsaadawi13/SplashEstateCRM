# FILE: /.env.example
# SplashEstate CRM - Environment Configuration
# Copy this file to .env and update with your settings

# Database Configuration
DB_HOST=localhost
DB_NAME=splashestate_crm
DB_USER=root
DB_PASS=

# Application Configuration
APP_NAME="SplashEstate CRM"
APP_ENV=development
APP_DEBUG=true
BASE_URL=http://localhost/SplashEstateCRM/public

# Session Configuration
SESSION_LIFETIME=7200

# Upload Configuration
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Email Configuration (for future use)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@splashestate.com
SMTP_FROM_NAME="SplashEstate CRM"

# Timezone
APP_TIMEZONE=UTC
