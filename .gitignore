# FILE: /.gitignore

# Environment configuration
.env

# Storage and uploads
storage/uploads/*
!storage/uploads/.gitkeep

# Logs
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Temporary files
*.tmp
*.bak
*.swp
*~

# Vendor directory if using Composer
/vendor/

# Cache files
*.cache
